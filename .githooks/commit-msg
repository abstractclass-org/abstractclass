#!/bin/sh
# The commit message's form (CLAUDE.md in the planning folder, "Commit messages"): a subject of at most 72
# characters, and body lines of at most 72. Git runs this hook when core.hooksPath names this folder
# (docs/working-notes.md). POSIX sh, with LF line ends: Git for Windows runs it in its own sh. The same hook as the
# planning folder's and the engine repository's (../.githooks/commit-msg and ../engines/.githooks/commit-msg): only
# the header comments differ. The planning folder's scripts/tests/test_hooks.py (SameHook) checks the three.
# The line after the subject is blank: Git takes the lines up to the first blank one as the subject. The message
# holds no private word (the check at the end).
#
# The hook reads the message as Git hands it, before Git takes out its comments. So it skips comment lines, and stops
# at the scissors line of `git commit -v`. It counts characters, not bytes. A body line with no space after its
# indentation and its list mark (a URL, a path) cannot wrap, so it may be longer. A subject that starts with
# "fixup! ", "squash! " or "amend! " goes away in a rebase, so it may be longer too. So may a subject that Git writes
# from other names: `Revert "<subject>"`, `Reapply "<subject>"` and the merges' `Merge branch '<name>' of <URL>`.
# Test: sh scripts/commit-msg.test.sh

LC_ALL=C awk '
	{ sub(/\r$/, "") }
	/^# -+ >8 -+$/ { exit }
	/^#/ { next }
	{
		# The characters: every byte that does not continue a UTF-8 character.
		chars = $0
		gsub(/[\200-\277]/, "", chars)
		n = length(chars)
	}
	!seen && n == 0 { next }
	!seen {
		seen = 1
		if (n > 72 && $0 !~ /^((fixup|squash|amend)! |(Revert|Reapply) "|Merge (remote-tracking )?(branch|branches|tag|commit) )/) {
			printf "commit-msg: the subject has %d characters (at most 72):\n  %s\n", n, $0
			bad = 1
		}
		second = 1
		next
	}
	second {
		second = 0
		if (n > 0) {
			printf "commit-msg: the line after the subject is not blank (Git would take it as the subject too):\n"
			printf "  %s\n", $0
			bad = 1
		}
	}
	n > 72 {
		rest = $0
		sub(/^[ \t]*([-*+>] |[0-9]+\. )?[ \t]*/, "", rest)
		if (rest ~ /[ \t]/) {
			printf "commit-msg: a body line has %d characters (at most 72):\n  %s\n", n, $0
			bad = 1
		}
	}
	END { exit bad }
' "$1" >&2 || {
	echo "commit-msg: no commit. Write a subject of at most 72 characters, a blank line, then the body wrapped at 72," \
		"and commit again." >&2
	exit 1
}
# Private words (abscls-jgc0): the message holds no word of the machine's list, as pre-commit checks the added lines
# (the planning folder's scripts/private-check, found from the main checkout). With no planning folder, no check. The
# check reads the lines that the awk above reads: with no CR, none from the scissors line on, no comment line. So a
# CRLF message of `git commit -v` sends no line of its diff (a commit that takes a word out was refused for it).
main=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && main=${main%/*}
if command -v python > /dev/null 2>&1; then py=python; else py=python3; fi  # the Mac: python3 when mise's is not on
for c in "$main/scripts/private-check" "$main/../scripts/private-check"; do
	[ -f "$c" ] || continue
	if ! command -v "$py" > /dev/null 2>&1; then
		echo "commit-msg: no python, so the check of private words is off" >&2
		break
	fi
	LC_ALL=C awk '{ sub(/\r$/, "") } /^# -+ >8 -+$/ { exit } /^#/ { next } { print }' "$1" |
		PYTHONUTF8=1 "$py" "$c" --label "the commit message" >&2 || {
		echo "commit-msg: no commit. Take the private word out of the message, then commit again." >&2
		exit 1
	}
	break
done
