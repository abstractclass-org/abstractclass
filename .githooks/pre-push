#!/bin/sh
# A note, never a refusal, on a push to dev while the workflow Tests runs on dev (docs/working-notes.md). Tests has a
# concurrency group for each commit (tests-<sha> in .github/workflows/tests.yml), so a push cancels no run, and each
# commit keeps its result. For a push to dev, this hook asks GitHub for the runs of Tests on dev, in the repository of
# the push's URL. For each run that is not completed (queued, in progress, waiting, requested or pending), it prints
# the run's id, its commit and its start, with the command that watches it. The push always goes ahead (exit 0). A push
# of any other ref passes at once, and prints nothing.
# When gh fails, the hook prints a warning, and the push goes ahead: GitHub's API does not gate a push. gh fails when
# it is missing or not signed in, when api.github.com does not answer, and when the URL is not a GitHub repository's.
# Git runs this hook when core.hooksPath names this folder. It gives the remote's name and URL as $1 and $2, and one
# line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. POSIX sh, with LF line ends: Git for
# Windows runs it in its own sh.
# Test: sh scripts/pre-push.test.sh

to_dev=
while read -r _ _ remote_ref _; do
	[ "$remote_ref" = refs/heads/dev ] && to_dev=1
done
[ -n "$to_dev" ] || exit 0

# One line per run that is not completed: its id, its commit's short hash, when it started. A run for each recent
# commit can be in progress, so 20 leaves a wide margin.
running=$(gh run list --repo "$2" --workflow Tests --branch dev --limit 20 \
	--json status,databaseId,headSha,createdAt \
	--jq '.[] | select(.status != "completed") | "\(.databaseId) \(.headSha[0:7]) \(.createdAt)"') || {
	echo "pre-push: WARNING: gh failed, so the check for a running Tests run on dev did not run. The push goes ahead." >&2
	exit 0
}
[ -n "$running" ] || exit 0

{
	echo "pre-push: Tests is still running on dev. The push goes ahead, and each run keeps its own commit's result:"
	printf '%s\n' "$running" | while read -r id sha started; do
		echo "  run $id, commit $sha, started $started. To watch it, in the planning folder:"
		echo "    scripts/ci-watch abstractclass $sha"
	done
} >&2
exit 0
