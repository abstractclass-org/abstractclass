{
	"name": "drawingboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"src/**/*.test.ts\"",
		"engine": "node ../../packages/engine/src/fetch-engine.mjs",
		"fixtures": "node scripts/board-fixtures.mjs"
	},
	"dependencies": {
		"@abstractclass/analysis": "*",
		"@abstractclass/engine": "*",
		"@abstractclass/import": "*",
		"@abstractclass/practice": "*",
		"@abstractclass/record": "*",
		"@abstractclass/review": "*",
		"@abstractclass/site": "*"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"bits-ui": "^2.19.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
