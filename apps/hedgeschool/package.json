{
	"name": "hedgeschool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"engine": "node scripts/fetch-engine.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
		"test:layout": "playwright test",
		"build:cloudflare": "npm run engine -- --deploy && npm test && npm run check && npm run build"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"bits-ui": "^2.19.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@abstractclass/analysis": "*",
		"@abstractclass/engine": "*",
		"@abstractclass/record": "*",
		"@abstractclass/storage": "*",
		"@fontsource-variable/fira-code": "5.3.0",
		"onnxruntime-web": "1.30.0"
	}
}
