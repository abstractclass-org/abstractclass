# Cloudflare Pages' response headers (docs/design/11-early-access.md). Pages reads this file and does not serve it.

# Unlisted while in early access: no page or file is indexed (robots.txt and each page's noindex say the same).
/*
  X-Robots-Tag: noindex

# Files whose paths change when their content does: the build's hashed code, and the engine's artifacts, whose
# folders name the build and the network (engine.lock.json). Browsers keep them for a year without asking again.
# /engine/manifest.json is not among them: it names the current files, so it is checked on each load.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/engine/:id/:file
  Cache-Control: public, max-age=31536000, immutable

# The meaf.us tools' files (docs/design/11-early-access.md): the bookmarklet's code, which the bookmark loads at each
# click, and the userscript, which Tampermonkey checks for updates. Their paths stay when their content changes, so a
# browser asks again each time: an unchanged file costs a "not modified" reply. Without this, Cloudflare lets a
# browser keep a .js file for 4 hours.
/bookmarklet.js
  Cache-Control: no-cache

/hedge-school.user.js
  Cache-Control: no-cache

/hedge-school.meta.js
  Cache-Control: no-cache
